# LocalPod Configuration
# Copy this file to .env and fill in your values.

# Set to "true" to use test stubs instead of real APIs.
# This avoids burning API credits during development.
LOCALPOD_TEST_MODE=true

# ElevenLabs (text-to-speech)
ELEVENLABS_API_KEY=your-api-key-here
ELEVENLABS_VOICE_ID=your-voice-id-here
ELEVENLABS_MODEL_ID=eleven_monolingual_v1

# Megaphone.fm (podcast hosting)
MEGAPHONE_API_TOKEN=your-token-here
MEGAPHONE_NETWORK_ID=your-network-id
MEGAPHONE_PODCAST_ID=your-podcast-id

# Optional: override default paths
# LOCALPOD_ASSETS_DIR=/path/to/assets
# LOCALPOD_OUTPUT_DIR=/path/to/output
